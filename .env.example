# ===========================================
# Nastart Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# ===========================================

# --- Database Configuration ---
POSTGRES_USER=nastart
POSTGRES_PASSWORD=nastart_dev_password
POSTGRES_DB=nastart

# --- Telegram Bot Configuration ---
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your public webhook URL (use ngrok for local development)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/bot/webhook
# Random secret for webhook validation (generate with: openssl rand -hex 32)
TELEGRAM_SECRET_TOKEN=your_random_secret_here

# --- OCR Service Configuration ---
# Language code for PaddleOCR (id = Indonesian, en = English)
OCR_LANG=id

# --- API Configuration ---
# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# --- Frontend Configuration (when ready) ---
# NUXT_PUBLIC_API_URL=http://localhost:5000
